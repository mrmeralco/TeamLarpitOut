# Copy to server/.env (git-ignored).
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash
# GEMINI_MODEL=
# Sign-up codes (SMS/email) and the email verification link are logged by the demo notifier
# (only the code or link, nothing about the person).
# Optional demo/test mode: every one-time code is this 6-digit value, and "Open Gmail" on
# Verify your email follows the verification link directly.
# AUTH_FIXED_CODE=123456
# Base URL put in the emailed verification link (defaults to http://localhost:5173).
# APP_URL=http://localhost:5173
