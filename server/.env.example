# Copy to server/.env (git-ignored).
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional; defaults to gemini-3.8-flash
# GEMINI_MODEL=
# Sign-up codes (SMS/email) and the email verification link are logged by the demo notifier
# (only the code or link, nothing about the person).
# Optional demo/test mode: every one-time code is this 6-digit value, and "Open Gmail" on
# Verify your email follows the verification link directly.


# ML service (ml-service/, FastAPI): retrieval over Meralco's public bill guide for the charge chat.
# Optional: if it is not running, the chat answers without the "From Meralco's bill guide" passage.
ML_SERVICE_URL=http://127.0.0.1:8000

# Who reads bill photos:
#   gemini-ml (default): Gemini reads the photo; if Gemini fails (no key, quota used up, error,
#                        or no answer in VISION_PRIMARY_TIMEOUT_MS, default 15000), the ML service
#                        reads the same photo with local OCR (about 10 s). An "unreadable" answer
#                        from Gemini is final (retake the photo).
#   gemini: Gemini only (sends the photo to Google; use a synthetic or masked bill).
#   ml:     the ML service only (photo stays on this machine). Needs the ML service running.
# Energy label and aircon photos always use Gemini.
VISION_PROVIDER=gemini-ml
